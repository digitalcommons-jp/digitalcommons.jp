---
import Layout from '~/components/frame/Layout.astro';
import Hero from '~/components/03_tag/01_hero.astro';
import List from '~/components/03_tag/03_list.astro';
import { getTags } from '~/lib/content';
import { i18n, langs } from '~/i18n';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of langs) {
    for (const [tag, posts] of await getTags(lang)) {
      paths.push({ params: { lang: lang === 'ja' ? undefined : lang, tag }, props: { tag, posts } });
    }
  }
  return paths;
}

const { t } = i18n(Astro);

const { tag, posts } = Astro.props;
---

<Layout metadata={{ title: `${t('tags.title')}: ${tag}`, robots: { index: false } }}>
  <Hero tag={tag} />
  <List posts={posts} />
</Layout>
