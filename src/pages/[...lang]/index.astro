---
import Layout from '~/components/frame/Layout.astro';
import Hero from '~/components/00_home/01_hero.astro';
import Event from '~/components/00_home/03_event.astro';
import Project from '~/components/00_home/05_project.astro';
import { getSetting } from '~/lib/content';
import { i18n, langPaths } from '~/i18n';

export const getStaticPaths = langPaths;

const { lang } = i18n(Astro);
const site = await getSetting('site', lang);
---

<Layout metadata={{ title: site.name, ignoreTitleTemplate: true }} wave={false}>
  <!-- Rows, top to bottom. Each is a full-width <section class="row">. -->
  <Hero tagline={site.tagline} />
  <Event />
  <Project />
</Layout>
