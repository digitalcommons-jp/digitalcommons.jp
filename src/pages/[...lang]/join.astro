---
import Layout from '~/components/frame/Layout.astro';
import Hero from '~/components/04_page/01_hero.astro';
import Guide from '~/components/10_join/03_guide.astro';
import Follow from '~/components/10_join/05_follow.astro';
import { getPage } from '~/lib/content';
import { i18n, langPaths } from '~/i18n';

export const getStaticPaths = langPaths;

const { lang } = i18n(Astro);
const page = (await getPage('join', lang))!;
---

<Layout metadata={{ title: page.data.title, description: page.data.description }}>
  <Hero page={page} />
  <Guide page={page} />
  <Follow page={page} />
</Layout>
