---
import { render } from 'astro:content';
import Layout from '~/layouts/Layout.astro';
import { formatDate, useT, localePath } from '~/i18n';
import { getPosts, isEvent } from '~/lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const t = useT('ja');
const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, tags, event } = post.data;
---

<Layout metadata={{ title, description, openGraph: { type: 'article' } }}>
  <article class="container-cc container-cc-narrow section-lg">
    <header>
      <div class="post-meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {
          updated && (
            <span>
              （{t('post.updated')} {formatDate(updated)}）
            </span>
          )
        }
        {
          tags.map((tag) => (
            <a href={localePath(`/tags/${tag}`)} class="tag">
              {tag}
            </a>
          ))
        }
      </div>
      <h1 class="post-title">{title}</h1>
    </header>

    {
      isEvent(post) && event && (
        <dl class="event-details">
          <dt>{t('event.start')}</dt>
          <dd>
            {formatDate(event.start, 'ja', true)}
            {event.end && ` 〜 ${formatDate(event.end, 'ja', true)}`}
            {event.status !== 'scheduled' && `（${t(`event.status.${event.status}`)}）`}
          </dd>
          <dt>{t(`event.mode.${event.mode}`)}</dt>
          <dd>
            {[event.venue, event.address].filter(Boolean).join(' / ')}
            {event.onlineUrl && (
              <a class="text-link" href={event.onlineUrl}>
                {event.onlineUrl}
              </a>
            )}
          </dd>
          {event.contact && (
            <>
              <dt>{t('event.contact')}</dt>
              <dd>
                <a class="text-link" href={event.contact}>
                  {event.contact.replace(/^mailto:/, '')}
                </a>
              </dd>
            </>
          )}
        </dl>
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>
</Layout>
