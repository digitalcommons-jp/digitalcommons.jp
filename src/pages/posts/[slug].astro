---
import Layout from '~/components/frame/Layout.astro';
import Header from '~/components/02_post/01_header.astro';
import EventDetails from '~/components/02_post/03_event-details.astro';
import Body from '~/components/02_post/05_body.astro';
import { getPosts } from '~/lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, description, date, updated } = post.data;
---

<Layout
  metadata={{
    title,
    description,
    openGraph: {
      type: 'article',
      article: { publishedTime: date.toISOString(), modifiedTime: updated?.toISOString() },
      images: post.data.image
        ? [{ url: post.data.image.src, width: post.data.image.width, height: post.data.image.height }]
        : [],
    },
  }}
>
  <article class="container-cc page-body">
    <Header post={post} />
    <EventDetails post={post} />
    <Body post={post} />
  </article>
</Layout>
