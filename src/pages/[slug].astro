---
import { render } from 'astro:content';
import Layout from '~/layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => data.lang === 'ja');
  return pages.map((page) => ({ params: { slug: page.data.slug }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<Layout metadata={{ title: page.data.title, description: page.data.description }} lang={page.data.lang}>
  <article class="container-cc container-cc-narrow section-lg">
    <h1 class="heading-1">{page.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
  </article>
</Layout>
