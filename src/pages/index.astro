---
import Layout from '~/layouts/Layout.astro';
import Hero from '~/components/home/Hero.astro';
import Pickup from '~/components/home/Pickup.astro';
import Intro from '~/components/home/Intro.astro';
import UpcomingEvent from '~/components/home/UpcomingEvent.astro';
import LatestPosts from '~/components/home/LatestPosts.astro';
import JoinCta from '~/components/home/JoinCta.astro';
import { customComponents } from '~/components/custom';
import { getSetting } from '~/lib/content';

const home = await getSetting('home');
const site = await getSetting('site');
const sections = (home.sections ?? []).filter((s) => s.enabled);

const metadata = { title: site.legalName, ignoreTitleTemplate: true };
---

<Layout metadata={metadata}>
  {
    sections.map((s) => {
      switch (s.type) {
        case 'hero':
          return <Hero tagline={site.tagline} />;
        case 'pickup':
          return <Pickup slug={s.slug ?? ''} />;
        case 'intro':
          return <Intro tagline={site.tagline} />;
        case 'upcoming-event':
          return <UpcomingEvent />;
        case 'latest-posts':
          return <LatestPosts count={s.count} />;
        case 'custom': {
          const Component = customComponents[s.component ?? ''];
          return Component ? <Component {...(s.props ?? {})} /> : null;
        }
        case 'join-cta':
          return <JoinCta />;
        default:
          return null;
      }
    })
  }
</Layout>
