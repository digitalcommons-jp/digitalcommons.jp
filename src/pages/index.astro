---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import site from '../content/settings/site.json';
import hero from '../content/home/hero.json';
import about from '../content/home/about.json';
import join from '../content/home/join.json';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const headingLines = hero.heading.split('\n');
---

<Base title={`${site.title} — ${site.description}`} description={site.description}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1>
          {headingLines.map((line) => (
            <>
              {line}
              {line !== headingLines.at(-1) && <br />}
            </>
          ))}
        </h1>
        <p class="hero-lead">{hero.lead}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={hero.primaryHref}>{hero.primaryLabel}</a>
          <a class="btn btn-ghost" href="https://github.com/yno9/digitalcommons.jp">ソースを見る</a>
        </div>
      </div>

      <aside class="hero-panel" aria-label="ハイライト">
        <div class="stat-row">
          <div class="stat">
            <strong>Open</strong>
            <span>基盤とプロトコル</span>
          </div>
          <div class="stat">
            <strong>Local</strong>
            <span>日本の文脈から</span>
          </div>
          <div class="stat">
            <strong>Common</strong>
            <span>共有される知</span>
          </div>
        </div>
        <p class="panel-note">
          このページは Astro で組んだモックです。コンテンツはリポジトリで管理しています。
        </p>
      </aside>
    </div>
  </section>

  <section id="about">
    <div class="container">
      <div class="section-head">
        <h2>{about.heading}</h2>
        <p>{about.lead}</p>
      </div>
      <div class="about-grid">
        {about.cards.map((card) => (
          <article class="card">
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="pillars">
    <div class="container">
      <div class="section-head">
        <h2>Focus areas</h2>
        <p>最初に据える三つの柱。すべて相互接続を前提にしています。</p>
      </div>
      <div class="pillars">
        <article class="pillar">
          <div class="pillar-index">01 / PROTOCOL</div>
          <h3>プロトコルと相互運用</h3>
          <p>
            ActivityPub・DID・オープンな発行プロトコルなど、相互接続できる仕組みの実装と運用知を共有します。
          </p>
        </article>
        <article class="pillar">
          <div class="pillar-index">02 / ARCHIVE</div>
          <h3>保存と再利用</h3>
          <p>
            長期保存できる形式、参照可能なメタデータ、再利用可能なAPI。
            「読める」だけで終わらないアーカイブを目指します。
          </p>
        </article>
        <article class="pillar">
          <div class="pillar-index">03 / PRACTICE</div>
          <h3>運用の民主化</h3>
          <p>
            self-host、分散インフラ、コミュニティ運営のプレイブックを開き、実践可能な形で残します。
          </p>
        </article>
      </div>
    </div>
  </section>

  <section id="projects">
    <div class="container">
      <div class="section-head">
        <h2>Projects</h2>
        <p>いま動いている（動かしつつある）取り組みのスケッチです。</p>
      </div>
      <div class="project-list">
        {projects.map((project) => (
          <article class="project">
            <div class="project-tag">{project.data.tag}</div>
            <div>
              <h3>{project.data.title}</h3>
              <p>{project.data.summary}</p>
            </div>
            {project.data.linkHref && project.data.linkLabel ? (
              <a class="project-link" href={project.data.linkHref}>{project.data.linkLabel}</a>
            ) : (
              <span class="project-link muted">—</span>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="join" id="join">
    <div class="container">
      <div class="join-panel">
        <h2>{join.heading}</h2>
        <p>{join.body}</p>
        <div class="join-actions">
          <a class="btn btn-primary" href={join.buttonHref}>{join.buttonLabel}</a>
          <a class="btn btn-ghost" href={`mailto:${site.contactEmail}`}>連絡する</a>
        </div>
      </div>
    </div>
  </section>
</Base>
