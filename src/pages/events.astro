---
import Layout from '~/components/frame/Layout.astro';
import Upcoming from '~/components/01_events/01_upcoming.astro';
import Past from '~/components/01_events/03_past.astro';
import { useT } from '~/i18n';

const t = useT('ja');
---

<Layout metadata={{ title: t('events.title') }}>
  <div class="container-cc section-lg">
    <h1 class="heading-1">{t('events.title')}</h1>
    <Upcoming />
    <Past />
  </div>
</Layout>
