---
import Layout from '~/components/frame/Layout.astro';
import Hero from '~/components/03_tag/01_hero.astro';
import List from '~/components/03_tag/03_list.astro';
import { t } from '~/i18n';
import { getTags } from '~/lib/content';

export async function getStaticPaths() {
  const tags = await getTags();
  return [...tags].map(([tag, posts]) => ({ params: { tag }, props: { tag, posts } }));
}

const { tag, posts } = Astro.props;
---

<Layout metadata={{ title: `${t('tags.title')}: ${tag}`, robots: { index: false } }}>
  <Hero tag={tag} />
  <List posts={posts} />
</Layout>
