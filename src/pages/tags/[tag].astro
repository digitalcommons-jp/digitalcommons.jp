---
import Layout from '~/components/frame/Layout.astro';
import List from '~/components/03_tag/01_list.astro';
import { useT } from '~/i18n';
import { getTags } from '~/lib/content';

export async function getStaticPaths() {
  const tags = await getTags();
  return [...tags].map(([tag, posts]) => ({ params: { tag }, props: { tag, posts } }));
}

const t = useT('ja');
const { tag, posts } = Astro.props;
---

<Layout metadata={{ title: `${t('tags.title')}: ${tag}`, robots: { index: false } }}>
  <List tag={tag} posts={posts} />
</Layout>
