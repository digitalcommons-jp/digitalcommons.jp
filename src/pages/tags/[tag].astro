---
import Layout from '~/layouts/Layout.astro';
import PostCard from '~/components/PostCard.astro';
import { useT } from '~/i18n';
import { getTags } from '~/lib/content';

export async function getStaticPaths() {
  const tags = await getTags();
  return [...tags].map(([tag, posts]) => ({ params: { tag }, props: { tag, posts } }));
}

const t = useT('ja');
const { tag, posts } = Astro.props;
---

<Layout metadata={{ title: `${t('tags.title')}: ${tag}`, robots: { index: false } }}>
  <div class="container-cc section-lg">
    <h1 class="heading-1">{t('tags.title')}: {tag}</h1>
    <ul class="card-grid">
      {
        posts.map((p) => (
          <li>
            <PostCard post={p} />
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
