---
import { useT, localePath } from '~/i18n';

const t = useT('ja');
---

<section class="container-cc container-cc-narrow section-lg">
  <p class="not-found-code">404</p>
  <h1 class="heading-2">{t('404.title')}</h1>
  <p class="text-muted">{t('404.body')}</p>
  <p><a href={localePath('/')} class="btn">{t('404.back')}</a></p>
</section>
