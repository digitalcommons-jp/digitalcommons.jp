---
import { SITE, METADATA, I18N } from 'astrowind:config';
import type { MetaData } from '~/types';
import { getCanonical } from '~/utils/permalinks';

export type Props = MetaData;

const { title, ignoreTitleTemplate = false, canonical, robots = {}, description, openGraph = {} } = Astro.props;

const siteName = openGraph.siteName ?? METADATA?.openGraph?.siteName ?? SITE?.name;
const pageTitle = title || METADATA?.title?.default || '';
const fullTitle = ignoreTitleTemplate ? pageTitle : (METADATA?.title?.template || '%s').replace('%s', pageTitle);
const desc = description || METADATA?.description;
const url = canonical ?? String(getCanonical(Astro.url.pathname));
const type = openGraph.type ?? 'website';
const index = robots.index ?? METADATA?.robots?.index ?? true;
const follow = robots.follow ?? METADATA?.robots?.follow ?? true;
const image = openGraph.images?.[0];
const imageUrl = image ? new URL(image.url, Astro.site).toString() : undefined;
---

<title>{fullTitle}</title>
{desc && <meta name="description" content={desc} />}
<link rel="canonical" href={url} />
<meta name="robots" content={`${index ? 'index' : 'noindex'}, ${follow ? 'follow' : 'nofollow'}`} />

<meta property="og:title" content={pageTitle} />
<meta property="og:type" content={type} />
<meta property="og:url" content={url} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={openGraph.locale ?? (I18N?.language === 'ja' ? 'ja_JP' : I18N?.language)} />
{desc && <meta property="og:description" content={desc} />}
{imageUrl && <meta property="og:image" content={imageUrl} />}
{image?.width && <meta property="og:image:width" content={String(image.width)} />}
{image?.height && <meta property="og:image:height" content={String(image.height)} />}
{
  type === 'article' && openGraph.article?.publishedTime && (
    <meta property="article:published_time" content={openGraph.article.publishedTime} />
  )
}
{
  type === 'article' && openGraph.article?.modifiedTime && (
    <meta property="article:modified_time" content={openGraph.article.modifiedTime} />
  )
}
<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
