---
import PostCard from '~/components/shared/PostCard.astro';
import { t } from '~/i18n';
import { getEvents } from '~/lib/content';

const { upcoming } = await getEvents();
---

<section class="block-gap">
  <h2 class="heading-2">{t('events.upcoming')}</h2>
  {
    upcoming.length ? (
      <ul class="card-grid">
        {upcoming.map((p) => (
          <li>
            <PostCard post={p} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-muted">{t('events.noUpcoming')}</p>
    )
  }
</section>
