---
import ItemRow from '~/components/shared/ItemRow.astro';
import { formatDate, t } from '~/i18n';
import { getEvents, type Post } from '~/lib/content';

const { upcoming, past } = await getEvents();

const rowOf = (p: Post, label: string) => {
  const { event } = p.data;
  return {
    post: p,
    label,
    meta: [
      formatDate(event!.start, true),
      ...(event!.status !== 'scheduled' ? [t(`event.status.${event!.status}`)] : []),
    ],
  };
};
const rows = [...upcoming.map((p) => rowOf(p, t('events.upcoming'))), ...past.map((p) => rowOf(p, t('events.past')))];
---

{
  rows.length ? (
    rows.map(({ post, label, meta }) => (
      <ItemRow
        title={post.data.title}
        description={post.data.description}
        href={`/posts/${post.id}`}
        label={label}
        meta={meta}
        image={post.data.image}
      />
    ))
  ) : (
    <section class="row item-row">
      <div class="container-cc">
        <p class="text-muted">{t('events.noUpcoming')}</p>
      </div>
    </section>
  )
}
