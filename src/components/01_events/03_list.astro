---
// Every upcoming event except the hero one, newest date first.
import ItemRow from '~/components/shared/ItemRow.astro';
import { t } from '~/i18n';
import { eventWhen, getEvents, getPickedEvent } from '~/lib/content';

const { upcoming } = await getEvents();
const hero = await getPickedEvent();
const rows = upcoming
  .filter((p) => p.id !== hero?.id)
  .sort((a, b) => b.data.event!.start.valueOf() - a.data.event!.start.valueOf());
---

{
  rows.map((post) => (
    <ItemRow
      title={post.data.title}
      description={post.data.description}
      href={`/posts/${post.id}`}
      label={t('events.upcoming')}
      meta={[eventWhen(post.data.event!)]}
      image={post.data.image}
      seed={post.id}
    />
  ))
}
