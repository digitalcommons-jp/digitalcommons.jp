---
import { useT, localePath, type Lang } from '~/i18n';

interface Props {
  tagline: string;
  lang?: Lang;
}

const { tagline, lang = 'ja' } = Astro.props;
const t = useT(lang);
---

<section class="container-cc section-lg">
  <p class="heading-1">{tagline}</p>
  <p class="text-muted">
    オープンソース文化の醸成と、プライバシーをはじめとするデジタルライツの擁護に取り組む一般社団法人です。
  </p>
  <p>
    <a href={localePath('/about', lang)} class="btn-secondary">{t('home.moreAbout')}</a>
  </p>
</section>
