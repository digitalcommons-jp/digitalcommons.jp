---
// Upcoming events as cards, below the projects. Soonest first.
import ItemRow from '~/components/shared/ItemRow.astro';
import { eventWhen, getEvents } from '~/lib/content';
import { i18n } from '~/i18n';

const { lang, link } = i18n(Astro);

const { upcoming } = await getEvents(lang);
---

{
  upcoming.map((post) => (
    <ItemRow
      variant="inset"
      title={post.data.title}
      description={post.data.description}
      href={link(`/posts/${post.id}`)}
      head={{ kind: 'event', meta: [eventWhen(post.data.event!, lang)], cancelled: post.data.event!.status === 'cancelled' }}
      image={post.data.image}
      seed={post.id}
    />
  ))
}
