---
// Every project except the hero one, newest first.
import ItemRow from '~/components/shared/ItemRow.astro';
import { t } from '~/i18n';
import { getPickedProject, getProjects } from '~/lib/content';

const hero = await getPickedProject();
const projects = (await getProjects()).filter((p) => p.id !== hero?.id);
---

{
  projects.map((p) => (
    <ItemRow
      variant="inset"
      title={p.data.title}
      description={p.data.description}
      href={p.data.url}
      head={{ kind: 'project', phase: p.data.phase }}
      details={[
        { label: t('project.goal'), value: p.data.goal },
        { label: t('project.deliverable'), value: p.data.deliverable },
      ]}
      image={p.data.image}
      seed={p.id}
    />
  ))
}
