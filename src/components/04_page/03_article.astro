---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  page: CollectionEntry<'pages'>;
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<article class="container-cc container-cc-narrow section-lg">
  <h1 class="heading-1">{page.data.title}</h1>
  <div class="prose">
    <Content />
  </div>
</article>
