---
import ItemRow from '~/components/shared/ItemRow.astro';
import type { Post } from '~/lib/content';
import { i18n } from '~/i18n';

const { formatDate, link } = i18n(Astro);

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{
  posts.map((p) => (
    <ItemRow
      title={p.data.title}
      description={p.data.description}
      href={link(`/posts/${p.id}`)}
      head={{ kind: 'post', meta: [formatDate(p.data.date)] }}
      image={p.data.image}
      seed={p.id}
    />
  ))
}
