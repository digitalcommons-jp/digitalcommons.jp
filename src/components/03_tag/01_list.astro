---
import PostCard from '~/components/shared/PostCard.astro';
import { t } from '~/i18n';
import type { Post } from '~/lib/content';

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
---

<div class="container-cc section-lg">
  <h1 class="heading-1">{t('tags.title')}: {tag}</h1>
  <ul class="card-grid">
    {
      posts.map((p) => (
        <li>
          <PostCard post={p} />
        </li>
      ))
    }
  </ul>
</div>
