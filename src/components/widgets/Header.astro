---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash, getAsset } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
const isActive = (href?: string) => typeof href === 'string' && `/${trimSlash(href)}` === currentPath;

const persistKey = `header-${Array.from(
  JSON.stringify({ links, actions, isSticky, isDark, isFullWidth, showToggleTheme, showRssFeed, position })
)
  .reduce((hash, char) => (hash * 31 + char.charCodeAt(0)) >>> 0, 7)
  .toString(36)}`;
---

<aw-header transition:persist={persistKey}>
  <header
    class:list={[
      { sticky: isSticky, relative: !isSticky, dark: isDark },
      'top-0 z-40 flex-none mx-auto w-full border-b border-gray-50/0 transition-[opacity] ease-in-out',
    ]}
    {...isSticky ? { 'data-aw-sticky-header': true } : {}}
    {...id ? { id } : {}}
  >
    <div class="absolute inset-0"></div>

    <!-- Top bar: left spacer | centered logo | hamburger on the right -->
    <div class:list={['relative text-default py-3 px-3 lg:px-6 mx-auto w-full', { 'max-w-7xl': !isFullWidth }]}>
      <div class="header-bar flex items-center justify-between gap-4">
        <div class="header-spacer header-spacer-left flex-1" aria-hidden="true"></div>

        <a class="header-logo flex items-center justify-center" href={getHomePermalink()}>
          <Logo />
        </a>

        <div class="header-spacer header-spacer-right flex-1 flex items-center justify-end">
          <div class="flex items-center gap-2">
            {
              showToggleTheme && (
                <ToggleTheme iconClass="w-6 h-6 lg:w-5 lg:h-5 lg:inline-block" />
              )
            }
            {
              showRssFeed && (
                <a
                  class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                  aria-label="RSS Feed"
                  href={getAsset('/rss.xml')}
                >
                  <Icon name="tabler:rss" class="w-5 h-5" />
                </a>
              )
            }
            {
              actions?.length ? (
                <span class="hidden md:inline-flex">
                  {actions.map((btnProps) => (
                    <Button {...btnProps} class="ml-2 py-2.5 px-5.5 lg:px-6 font-semibold shadow-none text-sm w-auto" />
                  ))}
                </span>
              ) : null
            }
            <!-- Hamburger: always on the right, all breakpoints -->
            <div class="header-menu-toggle flex items-center">
              <ToggleMenu />
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Nav lives outside the top row so it can expand as a full overlay -->
    <nav
      class="header-nav hidden text-default"
      aria-label="Main navigation"
      id="header-nav"
    >
      <ul class="header-nav-list flex flex-col gap-1 text-xl font-medium w-full">
        {
          links.map(({ text, href, links }) => (
            <li class={links?.length ? 'dropdown' : ''}>
              {links?.length ? (
                <>
                  <button
                    type="button"
                    class="hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap w-full"
                  >
                    {text}{' '}
                    <Icon name="tabler:chevron-down" class="w-3.5 h-3.5 ml-0.5" />
                  </button>
                  <ul class="dropdown-menu pl-4 hidden font-medium">
                    {links.map(({ text: text2, href: href2 }) => (
                      <li>
                        <a
                          class:list={[
                            'first:rounded-t last:rounded-b hover:text-link dark:hover:text-white py-2 px-5 block whitespace-nowrap',
                            { 'aw-link-active': isActive(href2) },
                          ]}
                          href={href2}
                        >
                          {text2}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  class:list={[
                    'hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap',
                    { 'aw-link-active': isActive(href) },
                  ]}
                  href={href}
                >
                  {text}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </header>
</aw-header>

<style>
  aw-header {
    display: contents;
  }

  /* Logo is optically centered even when the left/right spacers differ. */
  .header-logo {
    min-width: 6rem;
  }

  /* Hamburger overlay menu — all breakpoints. */
  #header.expanded nav.header-nav {
    display: flex !important;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    align-items: center;
    justify-content: center;
    background: var(--aw-color-bg-page, #fff);
    padding: 5rem 1.5rem 2rem;
    overflow-y: auto;
  }

  .dark #header.expanded nav.header-nav {
    background: var(--aw-color-bg-page, #0f172a);
  }

  #header.expanded nav.header-nav .header-nav-list {
    width: min(100%, 22rem);
    text-align: center;
  }

  #header.expanded nav.header-nav .header-nav-list > li > a,
  #header.expanded nav.header-nav .header-nav-list > li > button {
    justify-content: center;
    border-radius: 0.5rem;
    font-size: 1.15rem;
    padding: 0.85rem 1rem;
  }

  #header.expanded nav.header-nav .header-nav-list > li > a:hover,
  #header.expanded nav.header-nav .header-nav-list > li > button:hover {
    background: rgb(0 0 0 / 5%);
  }

  .dark #header.expanded nav.header-nav .header-nav-list > li > a:hover,
  .dark #header.expanded nav.header-nav .header-nav-list > li > button:hover {
    background: rgb(255 255 255 / 8%);
  }
</style>

<script>
  class AwHeader extends HTMLElement {
    private onScroll?: () => void;
    private onPageLoad = () => {
      this.updateActiveLinks();
      this.closeOpenDropdown();
    };

    connectedCallback() {
      const header = this.querySelector<HTMLElement>('#header');
      const toggle = this.querySelector<HTMLElement>('[data-aw-toggle-menu]');
      const nav = this.querySelector<HTMLElement>('#header nav');

      this.updateActiveLinks();
      document.addEventListener('astro:page-load', this.onPageLoad);

      const closeMenu = () => {
        toggle?.classList.remove('expanded');
        toggle?.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('overflow-hidden');
        header?.classList.remove('h-screen', 'expanded', 'bg-page');
        nav?.classList.add('hidden');
      };

      // Hamburger toggle (all breakpoints).
      toggle?.addEventListener('click', () => {
        const expanded = toggle.classList.toggle('expanded');
        toggle.setAttribute('aria-expanded', String(expanded));
        document.body.classList.toggle('overflow-hidden');
        header?.classList.toggle('h-screen');
        header?.classList.toggle('expanded');
        header?.classList.toggle('bg-page');
        nav?.classList.toggle('hidden', !expanded);
      });

      nav?.addEventListener('click', closeMenu);

      // Escape closes the menu.
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeMenu();
      });

      if (header?.hasAttribute('data-aw-sticky-header')) {
        let ticking = false;
        const applyStyles = () => {
          if (window.scrollY > 60) header.classList.add('scroll');
          else header.classList.remove('scroll');
          ticking = false;
        };
        this.onScroll = () => {
          if (!ticking) {
            window.requestAnimationFrame(applyStyles);
            ticking = true;
          }
        };
        applyStyles();
        document.addEventListener('scroll', this.onScroll, { passive: true });
      }

      document.documentElement.classList.add('motion-safe:scroll-smooth');
    }

    disconnectedCallback() {
      if (this.onScroll) document.removeEventListener('scroll', this.onScroll);
      document.removeEventListener('astro:page-load', this.onPageLoad);
    }

    private closeOpenDropdown() {
      const active = document.activeElement as HTMLElement | null;
      if (active && this.contains(active) && active.closest('.dropdown')) active.blur();
    }

    private updateActiveLinks() {
      const norm = (p: string) => '/' + p.replace(/^\/+|\/+$/g, '');
      const current = norm(window.location.pathname);
      this.querySelectorAll<HTMLAnchorElement>('nav a[href]').forEach((a) => {
        const url = new URL(a.href, window.location.href);
        const isPathLink =
          url.origin === window.location.origin && !url.hash && !a.getAttribute('href')?.startsWith('#');
        a.classList.toggle('aw-link-active', isPathLink && norm(url.pathname) === current);
      });
    }
  }

  if (!customElements.get('aw-header')) {
    customElements.define('aw-header', AwHeader);
  }
</script>
