---
// Mission (goals) and the pillars (approaches). Full width, no background of its own: it continues the page background.
import type { getAbout } from '~/lib/about';
import { i18n } from '~/i18n';

const { t } = i18n(Astro);

type About = Awaited<ReturnType<typeof getAbout>>;
interface Props {
  mission: About['mission'];
  approaches: About['approaches'];
}

const { mission, approaches } = Astro.props;
const items = approaches?.items ?? [];

// A block with a single paragraph: the text without its <p> (the component draws its own).
const inline = (html: string) => html.trim().replace(/^<p>([\s\S]*)<\/p>$/, '$1');
---

<section class="row about">
  <div class="container-cc about-inner">
    {
      mission && (
        <div class="about-mission">
          {mission.title && <h2 class="item-row-label">{mission.title}</h2>}
          <p class="about-mission-text" set:html={inline(mission.html)} />
        </div>
      )
    }
    {
      items.length > 0 && (
        <div>
          <h2 class="item-row-label">{approaches?.title ?? t('about.approaches')}</h2>
          <ul class="about-approaches">
            {items.map((a) => (
              <li>
                <h3 class="about-approach-title">{a.title}</h3>
                <p class="text-muted" set:html={inline(a.html)} />
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>
