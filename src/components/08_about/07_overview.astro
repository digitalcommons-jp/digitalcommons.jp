---
// General information (団体概要) and a donation appeal. Desktop: one card in two columns. Mobile: two separate cards.
import type { CollectionEntry } from 'astro:content';
import { t } from '~/i18n';

interface Props {
  page: CollectionEntry<'pages'>;
}

const { overview = [], donation } = Astro.props.page.data;
---

{
  (overview.length > 0 || donation) && (
    <section class="row rigid-card overview">
      {overview.length > 0 && (
        <div class="overview-info">
          <h2 class="item-row-label">{t('about.overview')}</h2>
          <dl class="overview-list">
            {overview.map((o) => (
              <>
                <dt>{o.label}</dt>
                <dd>{o.value}</dd>
              </>
            ))}
          </dl>
        </div>
      )}
      {donation && (
        <div class="overview-donate">
          <h2 class="overview-donate-title">{donation.title}</h2>
          <p class="text-muted">{donation.text}</p>
          <p>
            <a href={donation.href} class="btn-primary">
              {donation.button}
            </a>
          </p>
        </div>
      )}
    </section>
  )
}
