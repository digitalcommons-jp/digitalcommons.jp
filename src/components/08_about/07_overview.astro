---
// General information (団体概要) and a donation appeal. Desktop: one card in two columns. Mobile: two separate cards.
import type { CollectionEntry } from 'astro:content';
import Donate from '~/components/shared/Donate.astro';
import { t } from '~/i18n';
import { getDonation } from '~/lib/content';

interface Props {
  page: CollectionEntry<'pages'>;
}

const { overview = [] } = Astro.props.page.data;
const donation = await getDonation();
---

{
  (overview.length > 0 || donation) && (
    <section class="row rigid-card overview">
      {overview.length > 0 && (
        <div class="overview-info">
          <h2 class="item-row-label">{t('about.overview')}</h2>
          <dl class="overview-list">
            {overview.map((o) => (
              <>
                <dt>{o.label}</dt>
                <dd>{o.value}</dd>
              </>
            ))}
          </dl>
        </div>
      )}
      <Donate />
    </section>
  )
}
