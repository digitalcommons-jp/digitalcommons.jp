---
// Staff members, two columns on desktop: each is avatar | name with language labels and social links beside it, and the PGP key band below them. No background of its own.
import type { CollectionEntry } from 'astro:content';
import SocialIcon from '~/components/shared/SocialIcon.astro';
import { t } from '~/i18n';
import { memberAvatar } from '~/lib/avatar';

interface Props {
  page: CollectionEntry<'pages'>;
}

const { members = [] } = Astro.props.page.data;
const services = [
  { key: 'bluesky', icon: 'bluesky', label: 'Bluesky' },
  { key: 'mastodon', icon: 'mastodon', label: 'Mastodon' },
  { key: 'didwebvh', icon: 'didwebvh', label: 'did:webvh' },
  { key: 'chat', icon: 'chat', label: 'Delta Chat' },
  { key: 'email', icon: 'mail', label: 'Email' },
] as const;
// "EN, FR" -> ['EN', 'FR']
const languages = (v?: string) =>
  (v ?? '')
    .split(/[,、，]/)
    .map((l) => l.trim())
    .filter(Boolean);
---

{
  members.length > 0 && (
    <section class="row members">
      <div class="container-cc members-inner">
        <h3 class="members-title">{t('about.members')}</h3>
        <ul class="member-list">
          {members.map((m) => (
            <li class="member">
              <div class="member-avatar" aria-hidden="true" set:html={memberAvatar(m.name)} />
              <div class="member-info">
                <div class="member-head">
                  <strong class="member-name">{m.name}</strong>
                  {languages(m.languages).length > 0 && (
                    <ul class="member-langs">
                      {languages(m.languages).map((l) => (
                        <li>{l}</li>
                      ))}
                    </ul>
                  )}
                  <ul class="member-social">
                    {services.map(
                      (s) =>
                        m[s.key] && (
                          <li>
                            <a href={s.key === 'email' ? `mailto:${m[s.key]}` : m[s.key]} aria-label={s.label}>
                              <SocialIcon icon={s.icon} />
                            </a>
                          </li>
                        ),
                    )}
                  </ul>
                </div>
                {m.pgp && (
                  <a href={m.pgp.file} download class="member-key" aria-label={t('about.pgpDownload')}>
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <!-- Lucide "key-round" (ISC license) -->
                      <path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z" />
                      <circle cx="16.5" cy="7.5" r=".5" fill="currentColor" />
                    </svg>
                    <code class="member-key-fingerprint">{m.pgp.fingerprint}</code>
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
