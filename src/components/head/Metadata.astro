---
import type { MetaData } from '~/types';
import { getSetting } from '~/lib/content';

export type Props = MetaData;

const { title, ignoreTitleTemplate = false, canonical, robots = {}, description, openGraph = {} } = Astro.props;

const site = await getSetting('site');

const siteName = openGraph.siteName ?? site.name;
const pageTitle = title || site.legalName;
const fullTitle = ignoreTitleTemplate ? pageTitle : `${pageTitle} — ${site.name}`;
const desc = description || site.description;
const url = canonical ?? new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '');
const type = openGraph.type ?? 'website';
const index = robots.index ?? true;
const follow = robots.follow ?? true;
const image = openGraph.images?.[0];
const imageUrl = image ? new URL(image.url, Astro.site).toString() : undefined;
---

<title>{fullTitle}</title>
{desc && <meta name="description" content={desc} />}
<link rel="canonical" href={url} />
<meta name="robots" content={`${index ? 'index' : 'noindex'}, ${follow ? 'follow' : 'nofollow'}`} />

<meta property="og:title" content={pageTitle} />
<meta property="og:type" content={type} />
<meta property="og:url" content={url} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={openGraph.locale ?? 'ja_JP'} />
{desc && <meta property="og:description" content={desc} />}
{imageUrl && <meta property="og:image" content={imageUrl} />}
{image?.width && <meta property="og:image:width" content={String(image.width)} />}
{image?.height && <meta property="og:image:height" content={String(image.height)} />}
{
  type === 'article' && openGraph.article?.publishedTime && (
    <meta property="article:published_time" content={openGraph.article.publishedTime} />
  )
}
{
  type === 'article' && openGraph.article?.modifiedTime && (
    <meta property="article:modified_time" content={openGraph.article.modifiedTime} />
  )
}
<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
