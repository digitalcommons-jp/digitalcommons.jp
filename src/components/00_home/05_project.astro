---
import ItemRow from '~/components/shared/ItemRow.astro';
import { getPickedProject } from '~/lib/content';
import { i18n } from '~/i18n';

const { lang, t, link } = i18n(Astro);

const latest = await getPickedProject(lang);
const more = { href: link('/actions'), text: t('home.moreProjects') };
---

{
  latest ? (
    <ItemRow
      variant="inset"
      title={latest.data.title}
      description={latest.data.description}
      href={latest.data.url}
      head={{ kind: 'project', phase: latest.data.phase }}
      details={[
        { label: t('project.goal'), value: latest.data.goal },
        { label: t('project.deliverable'), value: latest.data.deliverable },
      ]}
      image={latest.data.image}
      seed={latest.id}
      more={more}
    />
  ) : (
    <ItemRow
      variant="inset"
      head={{ kind: 'project' }}
      title={t('home.projects')}
      description={t('projects.empty')}
      more={more}
    />
  )
}
