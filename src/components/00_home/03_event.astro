---
import ItemRow from '~/components/shared/ItemRow.astro';
import { t } from '~/i18n';
import { eventWhen, getPickedEvent } from '~/lib/content';

const picked = await getPickedEvent();
---

{
  picked && (
    <ItemRow
      title={picked.data.title}
      description={picked.data.description}
      href={`/posts/${picked.id}`}
      label={t('home.events')}
      meta={[eventWhen(picked.data.event!)]}
      image={picked.data.image}
      seed={picked.id}
      more={{ href: '/events', text: t('home.moreEvents') }}
    />
  )
}
