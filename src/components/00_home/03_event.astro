---
import ItemRow from '~/components/shared/ItemRow.astro';
import { eventWhen, getPickedEvent } from '~/lib/content';
import { i18n } from '~/i18n';

const { lang, t, link } = i18n(Astro);

const picked = await getPickedEvent(lang);
---

{
  picked && (
    <ItemRow
      title={picked.data.title}
      description={picked.data.description}
      href={link(`/posts/${picked.id}`)}
      head={{ kind: 'event', meta: [eventWhen(picked.data.event!, lang)], cancelled: picked.data.event!.status === 'cancelled' }}
      image={picked.data.image}
      seed={picked.id}
      more={{ href: link('/actions'), text: t('home.moreEvents') }}
    />
  )
}
