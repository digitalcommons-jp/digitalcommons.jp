---
import { Image } from 'astro:assets';
import heroImage from '~/assets/images/hero-placeholder.svg';
import { t } from '~/i18n';

interface Props {
  tagline: string;
}

const { tagline } = Astro.props;
---

<section class="hero">
  <div class="hero-text">
    <h1 class="hero-title">{tagline}</h1>
    <p class="text-muted">
      オープンソース文化の醸成と、プライバシーをはじめとするデジタルライツの擁護に取り組む一般社団法人です。
    </p>
    <p class="hero-actions">
      <a href="/join" class="btn-primary">{t('nav.join')}</a>
      <a href="/about" class="btn-secondary">{t('home.moreAbout')}</a>
    </p>
  </div>
  <div class="hero-media">
    <!-- Placeholder photo: replace src/assets/images/hero-placeholder.svg -->
    <Image src={heroImage} alt="" width={1200} height={1000} />
  </div>
</section>
