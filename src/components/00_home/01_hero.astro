---
import art from '~/assets/images/nez-trace.svg?raw';
import { t } from '~/i18n';

interface Props {
  tagline: string;
}

const { tagline } = Astro.props;
---

<section class="row hero">
  <div class="container-cc hero-inner">
    <div class="hero-block">
      <h1 class="hero-title"><span class="hero-marker">{tagline}</span></h1>
      <div class="hero-body">
        <div class="hero-copy">
          <p class="text-muted">
            digital commons は、人間とテクノロジーのよりよい付きあい方の模索と実践をする非営利団体です。特にオープンソース文化の普及とプライバシー権をはじめとする人権の擁護に取り組んでいます。
          </p>
          <p class="hero-actions">
            <a href="/join" class="btn-primary">{t('nav.join')}</a>
            <a href="/about" class="btn-secondary">{t('home.moreAbout')}</a>
          </p>
        </div>
        <div class="hero-art" aria-hidden="true" set:html={art} />
      </div>
    </div>
  </div>
</section>
