---
import art from '~/assets/images/nez-trace.svg?raw';
import { i18n } from '~/i18n';

const { t, link } = i18n(Astro);

interface Props {
  tagline: string;
}

const { tagline } = Astro.props;
---

<section class="row hero">
  <div class="container-cc hero-inner">
    <div class="hero-block">
      <h1 class="hero-title"><span class="hero-marker">{tagline}</span></h1>
      <div class="hero-body">
        <div class="hero-copy">
          <p class="text-muted">
            {t('home.intro')}
          </p>
          <p class="hero-actions">
            <a href={link('/join')} class="btn-primary">{t('nav.join')}</a>
            <a href={link('/about')} class="btn-secondary">{t('home.moreAbout')}</a>
          </p>
        </div>
        <div class="hero-art" aria-hidden="true" set:html={art} />
      </div>
    </div>
  </div>
</section>
