---
import PostCard from '~/components/shared/PostCard.astro';
import { t } from '~/i18n';
import { getEvents } from '~/lib/content';

const { upcoming } = await getEvents();
const next = upcoming[0];
---

{
  next && (
    <section class="container-cc section">
      <div class="section-head">
        <h2 class="heading-2">{t('home.upcomingEvent')}</h2>
        <a href="/events" class="link-more">
          {t('home.moreEvents')}
        </a>
      </div>
      <PostCard post={next} />
    </section>
  )
}
