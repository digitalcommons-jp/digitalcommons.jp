---
import PostCard from '~/components/shared/PostCard.astro';
import { t } from '~/i18n';
import { getPosts } from '~/lib/content';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const post = (await getPosts()).find((p) => p.id === slug);
---

{
  post && (
    <section class="container-cc section">
      <h2 class="sr-only">{t('home.pickup')}</h2>
      <PostCard post={post} large />
    </section>
  )
}
