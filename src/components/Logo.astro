---
import { SITE } from 'astrowind:config';

// Two-line wordmark: "digital" / "commons".
// Each line has its own class so designers can style them independently.
const firstLine = 'digital';
const secondLine = 'commons';
---

<span class="logo wordmark self-center text-gray-900 dark:text-white" aria-label={SITE?.name ?? 'Digital Commons'}>
  <span class="logo-line logo-line-1">{firstLine}</span>
  <span class="logo-line logo-line-2">{secondLine}</span>
</span>

<style>
  /* Human-editable logo styles — feel free to change these. */
  .wordmark {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-transform: lowercase;
    white-space: nowrap;
  }

  .logo-line-1 {
    /* line 1: "digital" */
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
  }

  .logo-line-2 {
    /* line 2: "commons" */
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    opacity: 0.85;
  }
</style>
