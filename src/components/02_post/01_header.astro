---
import type { Post } from '~/lib/content';
import { i18n } from '~/i18n';

const { t, formatDate, link } = i18n(Astro);

interface Props {
  post: Post;
}

const { title, date, updated, tags } = Astro.props.post.data;
---

<header>
  <div class="post-meta">
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    {
      updated && (
        <span>
          （{t('post.updated')} {formatDate(updated)}）
        </span>
      )
    }
    {
      tags.map((tag) => (
        <a href={link(`/tags/${tag}`)} class="tag">
          {tag}
        </a>
      ))
    }
  </div>
  <h1 class="post-title">{title}</h1>
</header>
