---
import { eventWhen, isEvent, type Post } from '~/lib/content';
import { i18n } from '~/i18n';

const { lang, t, formatDate } = i18n(Astro);

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { event } = post.data;
---

{
  isEvent(post) && event && (
    <dl class="event-details">
      <dt>{t('event.start')}</dt>
      <dd>
        {eventWhen(event, lang)}
        {!event.when && event.end && ` 〜 ${formatDate(event.end, true)}`}
        {event.status !== 'scheduled' && `（${t(`event.status.${event.status}`)}）`}
      </dd>
      <dt>{t(`event.mode.${event.mode}`)}</dt>
      <dd>
        {[event.venue, event.address].filter(Boolean).join(' / ')}
        {event.onlineUrl && (
          <a class="text-link" href={event.onlineUrl}>
            {event.onlineUrl}
          </a>
        )}
      </dd>
      {event.fee && (
        <>
          <dt>{t('event.fee')}</dt>
          <dd>{event.fee}</dd>
        </>
      )}
      {event.contact && (
        <>
          <dt>{t('event.contact')}</dt>
          <dd>
            <a class="text-link" href={event.contact}>
              {event.contact.replace(/^mailto:/, '')}
            </a>
          </dd>
        </>
      )}
    </dl>
  )
}
{
  isEvent(post) && event?.contact && event.status === 'scheduled' && (
    <p class="event-apply">
      <a class="btn-primary" href={event.contact}>
        {t('event.apply')}
      </a>
    </p>
  )
}
