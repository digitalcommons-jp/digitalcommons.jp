---
import { Image } from 'astro:assets';
import { formatDate, t } from '~/i18n';
import type { Post } from '~/lib/content';

interface Props {
  post: Post;
  large?: boolean;
}

const { post, large = false } = Astro.props;
const { title, description, date, tags, image, event } = post.data;
const href = `/posts/${post.id}`;
---

<article class:list={['card', { 'card-large': large }]}>
  {
    image && (
      <a href={href} tabindex="-1" aria-hidden="true" class="card-image">
        <Image src={image} alt="" widths={[480, 960]} sizes="(min-width: 48rem) 30rem, 100vw" />
      </a>
    )
  }
  <div class="card-body">
    <div class="card-meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {
        tags.map((tag) => (
          <a href={`/tags/${tag}`} class="tag">
            {tag}
          </a>
        ))
      }
    </div>
    <h3 class="card-title">
      <a href={href}>{title}</a>
    </h3>
    <p class="card-text">{description}</p>
    {
      event && (
        <p class="card-event">
          {t('event.start')}：{formatDate(event.start, true)}
        </p>
      )
    }
  </div>
</article>
