---
// One full-width row for an event / project / post. Shared by the list pages and the landing page.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ComponentProps } from 'astro/types';
import { blobSvg, sliceSvg } from '~/lib/blob';
import ItemHead from '~/components/shared/ItemHead.astro';

type Head = ComponentProps<typeof ItemHead>;

interface Props {
  title: string;
  description: string;
  href?: string;
  /** The one-line header above the title: the kind's icon and facts (see ItemHead). */
  head: Head;
  /** Labelled facts under the description (e.g. goal / deliverable). */
  details?: { label: string; value: string }[];
  /** A real image. Without one, a generated blob picture is shown instead. */
  image?: ImageMetadata;
  /** Decides which blob picture is generated (default: the title). */
  seed?: string;
  more?: { href: string; text: string };
  /** bleed: image runs to the section edges, on the right. inset: image on the left, with margins, over a transparent background. */
  variant?: 'bleed' | 'inset';
}

const { title, description, href, head, details = [], image, seed, more, variant = 'bleed' } = Astro.props;
// The picture is a link to the same page as the title (kept out of the tab order and the accessibility tree).
const Media = href ? 'a' : 'div';
const mediaProps = href ? { href, tabindex: -1, 'aria-hidden': true } : {};
---

<section class:list={['row', 'fluid-section', 'item-row', `item-row-${variant}`]}>
  <div class="container-cc item-row-inner">
    <div class="item-row-text">
      <ItemHead {...head} />
      <h2 class="item-row-title">{href ? <a href={href}>{title}</a> : title}</h2>
      <p class="text-muted">{description}</p>
      {
        details.length > 0 && (
          <dl class="item-row-details">
            {details.map((d) => (
              <>
                <dt>{d.label}</dt>
                <dd>{d.value}</dd>
              </>
            ))}
          </dl>
        )
      }
      {
        more && (
          <p>
            <a href={more.href} class="link-more">
              {more.text}
            </a>
          </p>
        )
      }
    </div>
    <div class="item-row-media">
      <Media class="item-row-media-link" {...mediaProps}>
        {
          image ? (
            image.format === 'svg' ? (
              <img src={image.src} alt="" width={image.width} height={image.height} loading="lazy" />
            ) : (
              <Image src={image} alt="" widths={[480, 960]} sizes="(min-width: 42rem) 40rem, 100vw" />
            )
          ) : (
            <Fragment set:html={variant === 'inset' ? sliceSvg(seed ?? title) : blobSvg(seed ?? title)} />
          )
        }
      </Media>
    </div>
  </div>
</section>
