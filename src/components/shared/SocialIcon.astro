---
// Icon of a social service, drawn with currentColor. didwebvh (white on black) and chat (the Delta Chat logo, black on
// transparent) are PNGs, so they are shown as masks.
import deltachat from '~/assets/deltachat-icon.png';
import didwebvh from '~/assets/didwebvh-icon.png';

interface Props {
  icon: 'rss' | 'bluesky' | 'mastodon' | 'didwebvh' | 'mail' | 'chat';
}

const { icon } = Astro.props;
---

{
  icon === 'didwebvh' ? (
    <span class="icon-didwebvh" style={`--icon: url(${didwebvh.src})`} aria-hidden="true" />
  ) : icon === 'chat' ? (
    <span class="icon-deltachat" style={`--icon: url(${deltachat.src})`} aria-hidden="true" />
  ) : (
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      {
        icon === 'mail' && (
          <>
            <rect width="20" height="16" x="2" y="4" rx="2" />
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
          </>
        )
      }
      {icon === 'rss' && <path d="M4 19a1 1 0 1 0 2 0a1 1 0 1 0-2 0M4 4a16 16 0 0 1 16 16M4 11a9 9 0 0 1 9 9" />}
      {
        icon === 'bluesky' && (
          <path d="M6.335 5.144C4.681 3.945 2 3.017 2 5.97c0 .59.35 4.953.556 5.661C3.269 14.094 5.686 14.381 8 14c-4.045.665-4.889 3.208-2.667 5.41C6.363 20.428 7.246 21 8 21c2 0 3.134-2.769 3.5-3.5q.5-1 .5-1.5q0 .5.5 1.5c.366.731 1.5 3.5 3.5 3.5c.754 0 1.637-.571 2.667-1.59C20.889 17.207 20.045 14.664 16 14c2.314.38 4.73.094 5.444-2.369c.206-.708.556-5.072.556-5.661c0-2.953-2.68-2.025-4.335-.826C15.372 6.806 12.905 10.192 12 12c-.905-1.808-3.372-5.194-5.665-6.856" />
        )
      }
      {
        icon === 'mastodon' && (
          <>
            <path d="M18.648 15.254C16.832 17.017 12 16.88 12 16.88a18.3 18.3 0 0 1-3.288-.256q1.69 2.977 8.982 2.475c-1.945 2.013-13.598 5.257-13.668-7.636L4 10.309c0-3.036.023-4.115 1.352-5.633C7.023 2.766 12 3.01 12 3.01s4.977-.243 6.648 1.667C19.977 6.195 20 7.274 20 10.31s-.456 4.074-1.352 4.944" />
            <path d="M12 11.204V8.278C12 7.02 11.105 6 10 6S8 7.02 8 8.278V13m4-4.722C12 7.02 12.895 6 14 6s2 1.02 2 2.278V13" />
          </>
        )
      }
    </svg>
  )
}
