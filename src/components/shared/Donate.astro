---
// The donation appeal ("活動を支えませんか"): the right column of the about / join cards (.overview). The text is
// written once, in the about page's `donation` (see getDonation).
import { getDonation } from '~/lib/content';
import { i18n } from '~/i18n';

const { lang } = i18n(Astro);

const donation = await getDonation(lang);
// The text is one paragraph: drop its <p> (the component draws its own).
const inline = (html: string) => html.trim().replace(/^<p>([\s\S]*)<\/p>$/, '$1');
---

{
  donation && (
    <div class="overview-donate">
      <h2 class="item-row-label">{donation.title}</h2>
      <p class="text-muted" set:html={inline(donation.html)} />
      <p>
        <a href={donation.href} class="btn-primary">
          {donation.button}
        </a>
      </p>
    </div>
  )
}
