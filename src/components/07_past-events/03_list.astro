---
import ItemRow from '~/components/shared/ItemRow.astro';
import { eventWhen, getEvents } from '~/lib/content';
import { i18n } from '~/i18n';

const { lang, t, link } = i18n(Astro);

const { past } = await getEvents(lang);
---

{
  past.length ? (
    past.map((post) => (
      <ItemRow
        title={post.data.title}
        description={post.data.description}
        href={link(`/posts/${post.id}`)}
        head={{ kind: 'event', meta: [eventWhen(post.data.event!, lang)], cancelled: post.data.event!.status === 'cancelled' }}
        image={post.data.image}
        seed={post.id}
      />
    ))
  ) : (
    <section class="row item-row fluid-section">
      <div class="container-cc">
        <p class="text-muted">{t('events.pastEmpty')}</p>
      </div>
    </section>
  )
}
