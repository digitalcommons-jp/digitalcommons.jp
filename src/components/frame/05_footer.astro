---
import { t } from '~/i18n';

interface Props {
  email: string;
}

const { email } = Astro.props;
---

<footer class="site-footer">
  <div class="container-cc footer-inner">
    <p>© {new Date().getFullYear()} {t('site.legalName')}</p>
    <ul class="footer-links">
      <li><a href="/privacy">{t('footer.privacy')}</a></li>
      <li><a href="/disclosure">{t('footer.disclosure')}</a></li>
      <li><a href={`mailto:${email}`}>{t('footer.contact')}</a></li>
    </ul>
  </div>
</footer>
