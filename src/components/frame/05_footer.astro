---
import { t } from '~/i18n';
import { nav } from '~/lib/nav';
import { getSetting } from '~/lib/content';
import { waveMask } from '~/lib/wave';
import LogoBlock from '~/components/shared/LogoBlock.astro';
import SocialIcon from '~/components/shared/SocialIcon.astro';

const site = await getSetting('site');

// '@user@host' -> https://host/@user
const [, user, host] = site.fediverse.split('@');
const social = [
  { label: 'RSS', href: '/feed.xml', icon: 'rss' as const },
  { label: 'Bluesky', href: `https://bsky.app/profile/${site.bluesky}`, icon: 'bluesky' as const },
  { label: 'Mastodon', href: `https://${host}/@${user}`, icon: 'mastodon' as const },
];
---

<footer class="site-footer">
  <div class="footer-wave" style={`--wave-mask: ${waveMask('footer')}`} aria-hidden="true"></div>
  <div class="container-cc footer-inner">
    <div>
      <div class="footer-brand">
        <LogoBlock />
        <!-- Language switch (like the header's): the current language is filled. Not wired up yet. -->
        <ul class="footer-lang">
          <li><button type="button" lang="en" aria-label={t('lang.en')}>en</button></li>
          <li><button type="button" lang="ja" aria-label={t('lang.ja')} aria-current="true">jp</button></li>
        </ul>
      </div>
      <ul class="footer-social">
        {
          social.map((s) => (
            <li>
              <a href={s.href} aria-label={s.label}>
                <SocialIcon icon={s.icon} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="footer-menus">
      <ul class="footer-links">
        {
          nav.map((i) => (
            <li>
              <a href={i.href}>{t(i.key)}</a>
            </li>
          ))
        }
      </ul>

      <ul class="footer-links">
        <li><a href="/privacy">{t('footer.privacy')}</a></li>
        <li><a href="/contact">{t('footer.contact')}</a></li>
      </ul>
    </div>
  </div>
</footer>
