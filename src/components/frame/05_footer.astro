---
import { i18n, switchPath } from '~/i18n';
import { nav } from '~/lib/nav';
import { getSocialLinks } from '~/lib/content';
import { waveMask } from '~/lib/wave';
import LogoBlock from '~/components/shared/LogoBlock.astro';
import SocialIcon from '~/components/shared/SocialIcon.astro';

const { lang, t, link } = i18n(Astro);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const social = await getSocialLinks(lang);
---

<footer class="site-footer">
  <div class="footer-wave" style={`--wave-mask: ${waveMask('footer')}`} aria-hidden="true"></div>
  <div class="container-cc footer-inner">
    <div>
      <div class="footer-brand">
        <LogoBlock />
        <!-- Language switch (like the header's): the current language is filled. -->
        <ul class="footer-lang">
          <li><a href={switchPath(path, 'en')} lang="en" hreflang="en" aria-label={t('lang.en')} aria-current={lang === 'en' ? 'true' : undefined}>en</a></li>
          <li><a href={switchPath(path, 'ja')} lang="ja" hreflang="ja" aria-label={t('lang.ja')} aria-current={lang === 'ja' ? 'true' : undefined}>jp</a></li>
        </ul>
      </div>
      <ul class="footer-social">
        {
          social.map((s) => (
            <li>
              <a href={s.href} aria-label={s.label}>
                <SocialIcon icon={s.icon} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="footer-menus">
      <ul class="footer-links">
        {
          nav.map((i) => (
            <li>
              <a href={link(i.href)}>{t(i.key)}</a>
            </li>
          ))
        }
      </ul>

      <ul class="footer-links">
        <li><a href={link('/privacy')}>{t('footer.privacy')}</a></li>
        <li><a href="mailto:contact@digitalcommons.jp">{t('footer.contact')}</a></li>
      </ul>
    </div>
  </div>
</footer>
