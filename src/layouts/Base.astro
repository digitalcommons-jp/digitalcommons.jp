---
import site from '../content/settings/site.json';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = site.description,
} = Astro.props;

// Join paths under Astro `base` (needed on path-based hosts).
const withBase = (path: string) => {
  const base = import.meta.env.BASE_URL.endsWith('/')
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;
  return `${base}${path.replace(/^\//, '')}`;
};
const homeHref = withBase('');
const faviconHref = withBase('favicon.svg');
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://digitalcommons.jp/" />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href={homeHref}>
          <span class="logo-mark" aria-hidden="true"></span>
          <span class="logo-text">Digital Commons<span class="logo-jp">.jp</span></span>
        </a>
        <nav class="nav" aria-label="メインナビゲーション">
          <a href="#about">About</a>
          <a href="#pillars">Focus</a>
          <a href="#projects">Projects</a>
          <a href="#join">Join</a>
        </nav>
        <a class="header-cta" href="#join">{site.ctaLabel}</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <div class="logo">
            <span class="logo-mark" aria-hidden="true"></span>
            <span class="logo-text">Digital Commons<span class="logo-jp">.jp</span></span>
          </div>
          <p>オープンなデジタル基盤と、共有される知を育てる。</p>
        </div>
        <div class="footer-meta">
          <p>
            <a href="https://github.com/yno9/digitalcommons.jp">Source on GitHub</a>
            {' · '}
            <a href="https://codeberg.org/digico/digitalcommons.jp">Codeberg</a>
          </p>
          <p class="muted">© {new Date().getFullYear()} {site.title}</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0c1222;
    --bg-elevated: #121a2e;
    --ink: #e8edf7;
    --ink-muted: #9aa8c0;
    --accent: #3d9cf0;
    --accent-soft: rgba(61, 156, 240, 0.14);
    --line: rgba(232, 237, 247, 0.1);
    --radius: 14px;
    --max: 1080px;
    font-family:
      'Hiragino Sans',
      'Hiragino Kaku Gothic ProN',
      'Noto Sans JP',
      'Segoe UI',
      sans-serif;
    color: var(--ink);
    background: var(--bg);
    line-height: 1.7;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(1200px 500px at 80% -10%, rgba(61, 156, 240, 0.18), transparent 60%),
      radial-gradient(900px 400px at 10% 20%, rgba(94, 234, 212, 0.08), transparent 55%),
      var(--bg);
    color: var(--ink);
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  .container {
    width: min(100% - 2.5rem, var(--max));
    margin-inline: auto;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(14px);
    background: rgba(12, 18, 34, 0.78);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 68px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .logo:hover {
    text-decoration: none;
  }

  .logo-mark {
    width: 1.55rem;
    height: 1.55rem;
    border-radius: 0.45rem;
    background:
      linear-gradient(135deg, var(--accent), #5eead4 70%);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .logo-jp {
    color: var(--accent);
  }

  .nav {
    display: flex;
    gap: 1.25rem;
    margin-left: auto;
  }

  .nav a {
    color: var(--ink-muted);
    font-size: 0.95rem;
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--ink);
    text-decoration: none;
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    background: var(--accent);
    color: #04101f;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .header-cta:hover {
    filter: brightness(1.08);
    text-decoration: none;
  }

  main {
    overflow: hidden;
  }

  .hero {
    padding: 5.5rem 0 4rem;
  }

  .hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    margin: 0 0 1.25rem;
  }

  .eyebrow::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px rgba(61, 156, 240, 0.2);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.3rem, 5vw, 3.6rem);
    line-height: 1.18;
    letter-spacing: -0.035em;
    font-weight: 800;
  }

  .hero-lead {
    margin: 1.25rem 0 0;
    color: var(--ink-muted);
    font-size: 1.12rem;
    max-width: 38rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.35rem;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    border: 1px solid transparent;
  }

  .btn:hover {
    text-decoration: none;
  }

  .btn-primary {
    background: var(--accent);
    color: #04101f;
  }

  .btn-primary:hover {
    filter: brightness(1.08);
  }

  .btn-ghost {
    border-color: var(--line);
    color: var(--ink);
    background: rgba(255, 255, 255, 0.02);
  }

  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  .hero-panel {
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 6px);
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.015));
    padding: 1.5rem;
  }

  .stat-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .stat {
    padding: 1rem;
    border-radius: 12px;
    background: rgba(12, 18, 34, 0.55);
    border: 1px solid var(--line);
  }

  .stat strong {
    display: block;
    font-size: 1.55rem;
    letter-spacing: -0.03em;
  }

  .stat span {
    color: var(--ink-muted);
    font-size: 0.86rem;
  }

  .panel-note {
    margin: 1.15rem 0 0;
    color: var(--ink-muted);
    font-size: 0.92rem;
  }

  section {
    padding: 4.25rem 0;
  }

  .section-head {
    max-width: 40rem;
    margin-bottom: 2.25rem;
  }

  .section-head h2 {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    letter-spacing: -0.03em;
    line-height: 1.25;
  }

  .section-head p {
    margin: 0.85rem 0 0;
    color: var(--ink-muted);
    font-size: 1.05rem;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 1.5rem;
  }

  .card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.03);
    padding: 1.5rem;
  }

  .card h3 {
    margin: 0 0 0.65rem;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .card p {
    margin: 0;
    color: var(--ink-muted);
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.15rem;
  }

  .pillar {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.55rem;
    background: linear-gradient(180deg, rgba(61, 156, 240, 0.08), rgba(255, 255, 255, 0.02));
  }

  .pillar-index {
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .pillar h3 {
    margin: 0.75rem 0 0.55rem;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  .pillar p {
    margin: 0;
    color: var(--ink-muted);
  }

  .project-list {
    display: grid;
    gap: 0.95rem;
  }

  .project {
    display: grid;
    grid-template-columns: 8rem 1fr auto;
    gap: 1.25rem;
    align-items: center;
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.025);
  }

  .project-tag {
    display: inline-flex;
    justify-content: center;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .project h3 {
    margin: 0;
    font-size: 1.08rem;
    letter-spacing: -0.015em;
  }

  .project p {
    margin: 0.35rem 0 0;
    color: var(--ink-muted);
    font-size: 0.95rem;
  }

  .project-link {
    white-space: nowrap;
    font-weight: 700;
    font-size: 0.92rem;
  }

  .join {
    position: relative;
  }

  .join-panel {
    border-radius: calc(var(--radius) + 8px);
    border: 1px solid rgba(61, 156, 240, 0.28);
    background:
      linear-gradient(135deg, rgba(61, 156, 240, 0.16), rgba(94, 234, 212, 0.08) 55%, rgba(255, 255, 255, 0.03));
    padding: 2.4rem;
  }

  .join-panel h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    letter-spacing: -0.03em;
  }

  .join-panel p {
    margin: 0.9rem 0 0;
    color: var(--ink-muted);
    max-width: 40rem;
    font-size: 1.05rem;
  }

  .join-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.75rem;
  }

  .site-footer {
    border-top: 1px solid var(--line);
    padding: 2.5rem 0 3rem;
    margin-top: 1rem;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: end;
  }

  .footer-brand p {
    margin: 0.85rem 0 0;
    color: var(--ink-muted);
  }

  .footer-meta {
    text-align: right;
    color: var(--ink-muted);
    font-size: 0.92rem;
  }

  .footer-meta p {
    margin: 0.35rem 0;
  }

  .muted {
    color: var(--ink-muted);
  }

  @media (max-width: 860px) {
    .nav {
      display: none;
    }

    .hero {
      padding-top: 3.5rem;
    }

    .about-grid,
    .pillars {
      grid-template-columns: 1fr;
    }

    .project {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .stat-row {
      grid-template-columns: 1fr;
    }

    .footer-inner {
      flex-direction: column;
      align-items: start;
    }

    .footer-meta {
      text-align: left;
    }
  }
</style>
