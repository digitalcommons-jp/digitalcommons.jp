[
  {
    "id": "publish",
    "execute-command": "/opt/digitalcommons/deploy/webhook/trigger.sh",
    "command-working-directory": "/opt/digitalcommons",
    "response-message": "publish queued",
    "trigger-rule": {
      "and": [
        {
          "match": {
            "type": "payload-hmac-sha256",
            "secret": "{{ getenv "WEBHOOK_SECRET" | js }}",
            "parameter": { "source": "header", "name": "X-Forgejo-Signature" }
          }
        },
        {
          "match": { "type": "value", "value": "refs/heads/main", "parameter": { "source": "payload", "name": "ref" } }
        }
      ]
    }
  }
]
