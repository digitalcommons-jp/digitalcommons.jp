# Trial run of the production build on a localhost-only port (no TLS, no GoToSocial, no
# interference with other sites on the host). Run:
#   caddy run --config /opt/dc/deploy/Caddyfile.local --adapter caddyfile
{
	admin off
	auto_https off
}

http://127.0.0.1:4400 {
	bind 127.0.0.1
	encode zstd gzip
	root * /opt/dc/dist
	try_files {path} {path}/index.html
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	@pub path /.well-known/site.standard.publication
	header @pub Content-Type "text/plain; charset=utf-8"
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
