# Copy to /etc/digitalcommons/env (chmod 600, owner deploy). Never commit the real file.
DEPLOY_MODE=vps
DEPLOY_ROOT=/var/www/digitalcommons.jp
# Same value as the secret set on the Forgejo webhook.
WEBHOOK_SECRET=change-me
# standard.site: set to 1 after `npx sequoia-cli auth` + `init` were done as the deploy user.
SEQUOIA=0
# GoToSocial: base URL and a token with ONLY the write:statuses scope. Leave empty to skip posting.
GTS_URL=https://digitalcommons.jp
GTS_TOKEN=
