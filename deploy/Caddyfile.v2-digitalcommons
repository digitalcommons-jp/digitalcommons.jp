# Block in /etc/caddy/Caddyfile on v2 (shared Caddy). Static site + did:webvh identity files.
# AUTHORITATIVE COPY: ~/did.md/Caddyfile -- `~/did.md/deploy.sh client` installs that whole file as
# /etc/caddy/Caddyfile, so any edit made only on the server is lost at the next wallet deploy.
# Static site: /opt/dc/dist (rsync from scripts/deploy.sh). Identity documents are owned by
# byo-host (dc-host.service) in /var/lib/dc-host/root, outside dist/, so site deploys never touch them.
# Writes (PUT/POST/DELETE/OPTIONS) go to byo-host on 127.0.0.1:8796. No Cloudflare; TLS is HTTP-01.
digitalcommons.jp {
	import compress

	root * /opt/dc/dist

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# Writes (dito publish / unpublish) go to byo-host, which updates the same .well-known/
	# files and sets its own CORS headers: see server/host/byo-host.ts and dc-host.service.
	@write method PUT POST DELETE OPTIONS
	handle @write {
		reverse_proxy 127.0.0.1:8796
	}

	# The identity documents are owned by byo-host (dc-host.service) in /var/lib/dc-host/root,
	# outside the site's dist/, so redeploying the site never touches them. This must be a
	# handle with its own root: a second `root @matcher` is overridden by the catch-all `root *`.
	@identity path /.well-known/did.json /.well-known/did.jsonl /.well-known/did-witness.json
	handle @identity {
		root * /var/lib/dc-host/root
		header Access-Control-Allow-Origin "*"
		header Cache-Control "public, max-age=300"
		@didjson path /.well-known/did.json
		header @didjson Content-Type "application/json; charset=utf-8"
		@didjsonl path /.well-known/did.jsonl
		header @didjsonl Content-Type "application/jsonl; charset=utf-8"
		file_server
	}

	# Everything else is static. The identity-document headers live here, not above, so
	# they never land on top of byo-host's (a doubled Access-Control-Allow-Origin is a CORS error).
	handle {
		header /_astro/* Cache-Control "public, max-age=31536000, immutable"

		@pub path /.well-known/site.standard.publication /.well-known/atproto-did
		header @pub Content-Type "text/plain; charset=utf-8"

		# did:web / did:webvh identity documents (published from dito; public data only).
		# CORS open so browser-based resolvers can read them.
		@didjson path /.well-known/did.json
		header @didjson Content-Type "application/json; charset=utf-8"
		@didjsonl path /.well-known/did.jsonl
		header @didjsonl Content-Type "application/jsonl; charset=utf-8"
		@did path /.well-known/did.json /.well-known/did.jsonl /.well-known/atproto-did
		header @did Access-Control-Allow-Origin "*"
		header @did Cache-Control "public, max-age=300"

		try_files {path} {path}/index.html
		file_server
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
